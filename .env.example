# Database
DATABASE_URL=postgresql://sslchecker:sslchecker@localhost:5433/sslchecker

# API server
PORT=3001
NODE_ENV=development

# Auth (use hash in production)
DASHBOARD_PASSWORD=changeme
DASHBOARD_PASSWORD_HASH=
JWT_SECRET=change-me-to-a-long-random-string

# CORS — frontend origin when hosted separately
CORS_ORIGIN=http://localhost:5173

# Email
FALLBACK_EMAIL=admin@example.com
RESEND_API_KEY=
RESEND_FROM=SSL Checker <alerts@yourdomain.com>

# Jobs
CRON_SECRET=change-me-cron-secret
SSL_WARN_DAYS=14

# Client build (Vite)
VITE_API_URL=http://localhost:3001
