# Database
DATABASE_URL=postgresql://sslchecker:sslchecker@localhost:5433/sslchecker

# API server
PORT=3001
NODE_ENV=development

# Auth — use plain password OR a bcrypt hash (not both meanings in HASH field)
DASHBOARD_PASSWORD=changeme
# Must be bcrypt ($2a$ / $2b$ / $2y$). Leave empty to use DASHBOARD_PASSWORD only.
DASHBOARD_PASSWORD_HASH=
JWT_SECRET=change-me-to-a-long-random-string

# CORS — one origin, or * / all for any origin (dev only)
CORS_ORIGIN=http://localhost:5173

# Email
FALLBACK_EMAIL=admin@example.com
RESEND_API_KEY=
RESEND_FROM=SSL Checker <alerts@yourdomain.com>

# Jobs
CRON_SECRET=change-me-cron-secret
SSL_WARN_DAYS=14

# Ops error emails to FALLBACK_EMAIL (anti-spam defaults)
OPS_NOTIFY_COOLDOWN_MINUTES=30
OPS_NOTIFY_MAX_PER_HOUR=8
OPS_NOTIFY_DIGEST_SECONDS=90
OPS_NOTIFY_DIGEST_MAX_BATCH=5
