{
  "name": "ssl-checker-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test src/lib/ssl/*.test.ts src/lib/ops-notify.test.ts src/lib/jobs/*.test.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "docker:up": "docker compose up -d db",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:prod": "docker compose up -d",
    "pm2:start": "bash scripts/pm2.sh start",
    "pm2:restart": "bash scripts/pm2.sh restart",
    "pm2:stop": "bash scripts/pm2.sh stop",
    "pm2:status": "bash scripts/pm2.sh status",
    "pm2:logs": "bash scripts/pm2.sh logs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "resend": "^6.12.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.30",
    "prisma": "^6.19.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
